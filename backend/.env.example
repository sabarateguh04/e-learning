# Copy to .env and fill in — .env is git-ignored and never committed.
PORT_BE=4006
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:4007

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
