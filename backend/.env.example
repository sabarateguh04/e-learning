# ── Server ──────────────────────────────────────────────────────────────────
PORT_BE=4006
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
# Comma-separated browser origins allowed to call the API (frontend port 4007)
CORS_ORIGIN=http://localhost:4007

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=db_elearning
DB_PASSWORD=db_elearning
DB_NAME=db_elearning
# Optional legacy master-data database (read-only, imported once when local masters are empty)
LEGACY_DB_NAME=sm_learning

# ── Features ────────────────────────────────────────────────────────────────
CAPTCHA_DISABLED=false
MAIL_SIMULATE=true
ADMIN_CONTACT_EMAIL=admin@e-learning.local
ADMIN_CONTACT_PHONE=
